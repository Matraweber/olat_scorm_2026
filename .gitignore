# macOS metadata
.DS_Store
**/.DS_Store

# Editor / IDE / local tooling workspaces
.vscode/
.idea/
.claude/
*.swp
*~

# Screenshots from ad-hoc debugging sessions.
screenshots/

# Node dependencies (reinstalled from package.json / package-lock.json,
# which are committed so everyone gets the same versions).
node_modules/
npm-debug.log*
yarn-debug.log*

# Test output. The test code itself (test/), package.json and
# eslint.config.mjs are committed so the suite can't get lost again.
test-results/
test/visual/diffs/
# Visual baselines are machine-specific (font antialiasing), so each
# machine keeps its own (npm run test:visual:update).
test/visual/baselines/

